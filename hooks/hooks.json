{
  "description": "Lints text written into agent instruction files (Claude Code Edit/Write/MultiEdit, Codex apply_patch).",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/instruction-edit-hook.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
