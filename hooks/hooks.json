{
  "description": "Checks text written into agent instruction files (history notes, broken links, large net additions).",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/instruction-edit-hook.mjs\"", "timeout": 10 }
        ]
      }
    ]
  }
}
